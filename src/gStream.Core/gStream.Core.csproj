<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>gStream.Core</RootNamespace>
		<!-- Native AOT support — enabled via -p:PublishAot=true at publish time -->
		<PublishAot Condition="'$(PublishAot)' == 'true'">true</PublishAot>
		<TrimMode>partial</TrimMode>
		<JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' == 'true'">false</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="FFmpeg.GPL" Version="20260408.1.0" GeneratePathProperty="true" />
		<PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
		<PackageReference Include="SIPSorcery" Version="10.0.5" />
	</ItemGroup>
	<!-- Copy FFmpeg native libraries — Windows only (Linux/macOS use system FFmpeg) -->
	<ItemGroup Condition="'$(OS)' == 'Windows_NT'">
		<None Include="$(PkgFFmpeg_GPL)\runtimes\win-x64\native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
		<None Include="$(PkgFFmpeg_GPL)\build\native\bin\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
